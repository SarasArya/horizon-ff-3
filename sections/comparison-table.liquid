{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

<div
  class="comparison-table color-{{ section.settings.color_scheme }}"
  style="
    --comparison-table-highlight: {{ section.settings.highlight_color }};
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="comparison-table__wrapper comparison-table__wrapper--{{ section.settings.section_width }}">
    {%- comment -%} Heading area {%- endcomment -%}
    <div class="comparison-table__heading-area">
      {% if section.settings.heading != blank %}
        <h2 class="comparison-table__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="comparison-table__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    {%- comment -%} Content area: image + table {%- endcomment -%}
    <div class="comparison-table__content">
      {%- comment -%} Side image (desktop only) {%- endcomment -%}
      {% if section.settings.image != blank %}
        <div class="comparison-table__image">
          {{
            section.settings.image
            | image_url: width: 1444
            | image_tag:
              widths: '360, 540, 720, 1080, 1444',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'comparison-table__image-media',
              loading: 'lazy',
              alt: section.settings.image.alt
          }}
        </div>
      {% endif %}

      {%- comment -%} Table container {%- endcomment -%}
      <div class="comparison-table__table">
        {%- comment -%} Highlight column overlay {%- endcomment -%}
        <div class="comparison-table__highlight" aria-hidden="true">
          {% if section.settings.column_1_image != blank %}
            <div class="comparison-table__column-image comparison-table__column-image--top">
              {{
                section.settings.column_1_image
                | image_url: width: 128
                | image_tag:
                  widths: '48, 64, 96, 128',
                  sizes: '64px',
                  class: 'comparison-table__column-img',
                  loading: 'lazy',
                  alt: section.settings.column_1_image.alt
              }}
            </div>
          {% endif %}
        </div>

        {%- comment -%} Column headers {%- endcomment -%}
        <div class="comparison-table__column-headers">
          <div class="comparison-table__column-label comparison-table__column-label--hidden" aria-hidden="true">
            &nbsp;
          </div>
          <div class="comparison-table__column-label comparison-table__column-label--col1">
            {{ section.settings.column_1_heading | escape }}
          </div>
          <div class="comparison-table__column-label comparison-table__column-label--col2">
            {{ section.settings.column_2_heading | escape }}
          </div>
        </div>

        {%- comment -%} Table rows (blocks) {%- endcomment -%}
        <div class="comparison-table__rows">
          {{ children }}
        </div>

        {%- comment -%} Column 2 image at bottom {%- endcomment -%}
        {% if section.settings.column_2_image != blank %}
          <div class="comparison-table__column-2-image">
            {{
              section.settings.column_2_image
              | image_url: width: 98
              | image_tag:
                widths: '35, 49, 70, 98',
                sizes: '35px',
                class: 'comparison-table__column-2-img',
                loading: 'lazy',
                alt: section.settings.column_2_image.alt
            }}
          </div>
        {% endif %}

        {%- comment -%} Footnote {%- endcomment -%}
        {% if section.settings.footnote != blank %}
          <p class="comparison-table__footnote">{{ section.settings.footnote | escape }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .comparison-table {
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
  }

  .comparison-table__wrapper {
    margin-inline: auto;
  }

  .comparison-table__wrapper--page-width {
    max-width: var(--page-width);
    padding-inline: var(--padding-page);
  }

  .comparison-table__wrapper--full-width {
    max-width: 100%;
    padding-inline: var(--padding-page);
  }

  .comparison-table__heading-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    margin-block-end: 48px;
  }

  .comparison-table__heading {
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: 48px;
    line-height: 56px;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .comparison-table__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    color: rgb(var(--color-foreground));
    margin: 0;
    max-width: 700px;
  }

  .comparison-table__content {
    display: flex;
    flex-direction: row;
    gap: 32px;
    align-items: center;
  }

  .comparison-table__image {
    flex: 1 1 0%;
    min-width: 0;
  }

  .comparison-table__image-media {
    width: 100%;
    height: auto;
    aspect-ratio: 722 / 542;
    object-fit: cover;
    display: block;
    border-radius: var(--style-border-radius, 0);
  }

  .comparison-table__table {
    flex: 0 1 654px;
    position: relative;
    min-width: 0;
  }

  .comparison-table__highlight {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140px;
    right: 80px;
    background-color: var(--comparison-table-highlight, #C4E0CB);
    border-radius: 4px;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block-start: 8px;
  }

  .comparison-table__column-image--top {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .comparison-table__column-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    display: block;
  }

  .comparison-table__column-headers {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
    padding-block: 8px;
  }

  .comparison-table__column-label {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
    color: rgb(var(--color-foreground));
  }

  .comparison-table__column-label--hidden {
    flex: 1 1 auto;
    visibility: hidden;
  }

  .comparison-table__column-label--col1 {
    width: 140px;
    flex-shrink: 0;
    text-align: center;
  }

  .comparison-table__column-label--col2 {
    width: 80px;
    flex-shrink: 0;
    text-align: center;
  }

  .comparison-table__rows {
    position: relative;
    z-index: 1;
  }

  .comparison-table__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .comparison-table__row .comparison-table__cell:first-child {
    flex: 1 1 auto;
    min-width: 0;
  }

  .comparison-table__row .comparison-table__cell:nth-child(2) {
    width: 140px;
    flex-shrink: 0;
    justify-content: center;
  }

  .comparison-table__row .comparison-table__cell:nth-child(3) {
    width: 80px;
    flex-shrink: 0;
    justify-content: center;
  }

  .comparison-table__column-2-image {
    display: flex;
    justify-content: flex-end;
    padding-block: 8px;
    position: relative;
    z-index: 1;
  }

  .comparison-table__column-2-img {
    width: 35px;
    height: 49px;
    object-fit: contain;
    display: block;
  }

  .comparison-table__footnote {
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: 14px;
    line-height: 20px;
    color: rgb(var(--color-foreground));
    margin: 0;
    padding-block-start: 12px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .comparison-table__heading-area {
      gap: 4px;
      align-items: flex-start;
      text-align: start;
      margin-block-end: 24px;
    }

    .comparison-table__heading {
      font-size: 32px;
      line-height: 40px;
    }

    .comparison-table__description {
      font-size: 16px;
      line-height: 24px;
    }

    .comparison-table__content {
      flex-direction: column;
    }

    .comparison-table__image {
      display: none;
    }

    .comparison-table__table {
      flex: 1 1 auto;
      width: 100%;
    }

    .comparison-table__highlight {
      width: 82px;
      right: 60px;
    }

    .comparison-table__column-img {
      width: 48px;
      height: 48px;
    }

    .comparison-table__column-label {
      font-size: 12px;
      line-height: 16px;
    }

    .comparison-table__column-label--col1 {
      width: 82px;
    }

    .comparison-table__column-label--col2 {
      width: 60px;
    }

    .comparison-table__row .comparison-table__cell:nth-child(2) {
      width: 82px;
    }

    .comparison-table__row .comparison-table__cell:nth-child(3) {
      width: 60px;
    }

    .comparison-table__footnote {
      font-size: 12px;
      line-height: 16px;
      text-align: start;
    }

    .comparison-table__column-2-image {
      justify-content: center;
      padding-inline-end: 16px;
    }

    .comparison-table__column-2-img {
      width: 35px;
      height: 49px;
    }
  }
{% endstylesheet %}

{% schema %}
